@model IEnumerable<KindergartenCRUD.Models.Kindergarten.KindergartenIndexViewModel>


@{
    int rowNumber = 1;
}

<div class="h1">
    Kindergarten
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">GroupName</th>
                <th scope="col">ChildrenCount</th>
                <th scope="col">KindergartenName</th>
                <th scope="col">TeacherName</th>
                <th scope="col">CreatedAt</th>
                <th scope="col">UpdatedAt</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var KinderGarten in Model)
            {
                <tr>
                    <td>"@rowNumber"</td>
                    <td>@KinderGarten.GroupName</td>
                    <td>@KinderGarten.ChildrenCount</td>
                    <td>@KinderGarten.KindergartenName</td>
                    <td>@KinderGarten.TeacherName</td>
                    <td>@KinderGarten.CreatedAt</td>
                    <td>@KinderGarten.UpdatedAt</td>
                    <td>
                        <a asp-action="Delete" asp-controller="Kindergarten" asp-route-id="@KinderGarten.Id" type="submit" class="btn-outline-dark btn btn-danger">Delete</a>
                        <a asp-action="Details" asp-controller="Kindergarten" asp-route-id="@KinderGarten.Id" type="submit" class="btn-outline-dark btn btn-info">Details</a>
                        <a asp-action="Update" asp-controller="Kindergarten" asp-route-id="@KinderGarten.Id" type="submit" class="btn btn-outline-dark btn-warning">Update</a>


                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
    </table>
</form>
<a asp-action="Index" asp-controller="Home" type="" class="btn btn-primary  btn-lg  btn-outline-dark ">Back to home</a>


<a asp-action="Create" asp-controller="Kindergarten" type="" class="btn btn-primary  btn-lg  btn-outline-dark ">Create</a>
