@model IEnumerable<KindergartenCRUD.Models.Kindergarten.KindergartenIndexViewModel>

@{
    int rowNumber = 1;
}

<div class="container mt-5">

    <h1 class="text-center mb-4">Kindergarten</h1>

    <form method="get">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Nr</th>
                    <th>GroupName</th>
                    <th>ChildrenCount</th>
                    <th>KindergartenName</th>
                    <th>TeacherName</th>
                    <th>CreatedAt</th>
                    <th>UpdatedAt</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var KinderGarten in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@KinderGarten.GroupName</td>
                        <td>@KinderGarten.ChildrenCount</td>
                        <td>@KinderGarten.KindergartenName</td>
                        <td>@KinderGarten.TeacherName</td>
                        <td>@KinderGarten.CreatedAt</td>
                        <td>@KinderGarten.UpdatedAt</td>
                        <td>
                            <a asp-action="Details"
                               asp-controller="Kindergarten"
                               asp-route-id="@KinderGarten.Id"
                               class="btn btn-info btn-sm">
                                Details
                            </a>

                            <a asp-action="Update"
                               asp-controller="Kindergarten"
                               asp-route-id="@KinderGarten.Id"
                               class="btn btn-warning btn-sm">
                                Update
                            </a>

                            <a asp-action="Delete"
                               asp-controller="Kindergarten"
                               asp-route-id="@KinderGarten.Id"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>
                    </tr>

                    rowNumber++;
                }
            </tbody>
        </table>
    </form>

    <div class="mt-3">
        <a asp-action="Index"
           asp-controller="Home"
           class="btn btn-secondary">
            Back to home
        </a>

        <a asp-action="Create"
           asp-controller="Kindergarten"
           class="btn btn-success">
            Create
        </a>
    </div>

</div>
